# Copy to .env and `source .env` (or export the variables) to override locations.
# Every variable is optional; defaults are relative to the project root. See musicml_paths.py.

# Project root (default: the directory containing musicml_paths.py)
# MUSICML_ROOT=/path/to/musicML

# Where external datasets live (PDMX, MAESTRO). Default: ~/datasets
# MUSICML_DATASETS=/path/to/datasets
# MUSICML_PDMX_ROOT=/path/to/datasets/pdmx

# Checkpoints and outputs (defaults: MIDI2ScoreTransformer/checkpoints and outputs/)
# MUSICML_CHECKPOINTS_DIR=
# MUSICML_OUTPUTS_DIR=

# Notation binaries (default: found on PATH, then the usual install locations)
# MUSICML_MUSESCORE=/Applications/MuseScore 4.app/Contents/MacOS/mscore
# MUSICML_LILYPOND=/opt/homebrew/bin/lilypond

# Compute device for evaluation scripts: cuda | cpu (default: cuda if available, else cpu; never mps)
# MUSICML_DEVICE=cpu

# Which GPU the training launchers use (default 0)
# MUSICML_GPU=0
# Set to 1 to let a launcher kill a previous train.py of yours before starting (default 0: never kill)
# KILL_EXISTING=0

# Manifest path rewrites, only if your packs live somewhere unusual (see pathmap.py for the defaults)
# MUSICML_PATH_MAP=/root/Music-ML-BayenLab=/path/to/musicML;/root/datasets=/path/to/datasets
# MUSICML_CACHE_MAP=/path/to/musicML/data/pairs_deduped_full=/path/to/musicML/data/cache_pdmx_full
